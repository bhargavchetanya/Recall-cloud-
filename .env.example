# Copy to .env and change values. .env is git-ignored.
POSTGRES_DB=recall
POSTGRES_USER=recall
POSTGRES_PASSWORD=recall
RABBITMQ_DEFAULT_USER=recall
RABBITMQ_DEFAULT_PASS=recall
# Signs the login tokens. Must be at least 32 bytes; use a long random string for anything shared.
RECALL_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
# Optional local AI fallback: set SPRING_PROFILES_ACTIVE=ai and run Ollama on this machine
# (ollama pull qwen2.5-coder:7b). Leave it empty to run without AI.
SPRING_PROFILES_ACTIVE=
RECALL_OLLAMA_URL=http://host.docker.internal:11434
# On machines with little free memory, qwen2.5-coder:1.5b is much lighter.
RECALL_OLLAMA_MODEL=qwen2.5-coder:7b
